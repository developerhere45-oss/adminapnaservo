# No password gate for now, as requested. Set this to "false" later when admin login is ready.
ADMIN_AUTH_DISABLED="true"
NEXT_PUBLIC_ENABLE_DEMO_DATA="false"

APP_BASE_URL="https://YOUR-ADMIN-SERVICE.onrender.com"
APNASERVO_BACKEND_URL="https://YOUR-BACKEND-SERVICE.onrender.com"
NEXT_PUBLIC_APNASERVO_BACKEND_URL="https://YOUR-BACKEND-SERVICE.onrender.com"

# Must exactly match backend ADMIN_API_SECRET.
ADMIN_BACKEND_SECRET="replace-with-same-32-plus-char-secret-as-backend-ADMIN_API_SECRET"

ADMIN_EMAIL="admin@apnaservo.com"

# Required only after ADMIN_AUTH_DISABLED is set to "false".
JWT_SECRET="change-this-long-random-secret-before-production"
# Generate with: node -e "require('bcryptjs').hash('YOUR_LONG_PASSWORD', 12).then(console.log)"
ADMIN_PASSWORD_HASH=""

# Optional for future local admin-auth/report DB features. Live dashboard data comes from APNASERVO_BACKEND_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/apnaservo_admin?schema=public"

SMTP_HOST=
PASSWORD_RESET_WEBHOOK_URL=
